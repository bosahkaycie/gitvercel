{
  "name": "pigl-corporate-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/generate-seo-assets.mjs",
    "build": "vite build && node scripts/prerender.mjs && npm run build:server",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --outfile=server.mjs --external:nodemailer --external:@supabase/supabase-js --external:dotenv",
    "start": "node server.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "^2.115.0",
    "@types/nodemailer": "^8.0.2",
    "dotenv": "^17.2.4",
    "nodemailer": "^10.0.10",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.5.0",
    "playwright": "^1.58.2",
    "postcss": "^8.5.15",
    "sharp": "^0.34.5",
    "svgo": "^4.1.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-image-optimizer": "^2.0.3"
  }
}
