# ==============================================================================
# Polaris Integrated & GeoSolutions (PIGL) - Hostinger Apache / LiteSpeed Config
# Production-ready configuration for Static SPA, PHP Mailer & Asset Optimization
# ==============================================================================

# 1. Disable Directory Browsing
Options -Indexes

# 2. Modern MIME Types
<IfModule mod_mime.c>
  AddType application/javascript js mjs
  AddType text/css css
  AddType image/svg+xml svg svgz
  AddType image/webp webp
  AddType image/avif avif
  AddType image/x-icon ico
  AddType font/woff woff
  AddType font/woff2 woff2
  AddType application/json json
  AddType video/mp4 mp4
  AddType application/pdf pdf
  AddType application/manifest+json webmanifest
</IfModule>

# 3. Enable Gzip & Brotli Compression for Maximum PageSpeed
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/woff
  AddOutputFilterByType DEFLATE font/woff2
</IfModule>

# 4. Leverage Browser Caching for Hashed Assets (Immutable 1-Year Cache)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
</IfModule>

# 5. Prevent Stale Browser Caching of HTML while allowing Back/Forward Cache (bfcache)
<FilesMatch "\.(html|htm)$">
  FileETag None
  <IfModule mod_headers.c>
    Header unset ETag
    Header set Cache-Control "no-cache, must-revalidate"
    Header set Pragma "no-cache"
  </IfModule>
</FilesMatch>

# 6. Global Security Headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
</IfModule>

# 7. URL Rewriting & SPA Routing
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 7A. Force HTTPS / SSL on Hostinger
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 7B. Route /api/send-email to PHP handler if running on standard Apache/PHP hosting
  RewriteCond %{REQUEST_URI} ^/api/send-email/?$ [NC]
  RewriteCond %{DOCUMENT_ROOT}/api/send-email.php -f
  RewriteRule ^api/send-email/?$ /api/send-email.php [L,QSA]

  RewriteCond %{REQUEST_URI} ^/api/company-profile/?$ [NC]
  RewriteCond %{DOCUMENT_ROOT}/api/company-profile.php -f
  RewriteRule ^api/company-profile/?$ /api/company-profile.php [L,QSA]

  RewriteCond %{REQUEST_URI} ^/api/social-links/?$ [NC]
  RewriteCond %{DOCUMENT_ROOT}/api/social-links.php -f
  RewriteRule ^api/social-links/?$ /api/social-links.php [L,QSA]

  RewriteCond %{REQUEST_URI} ^/api/settings/?$ [NC]
  RewriteCond %{DOCUMENT_ROOT}/api/settings.php -f
  RewriteRule ^api/settings/?$ /api/settings.php [L,QSA]

  RewriteCond %{REQUEST_URI} ^/api/page-headers/?$ [NC]
  RewriteCond %{DOCUMENT_ROOT}/api/page-headers.php -f
  RewriteRule ^api/page-headers/?$ /api/page-headers.php [L,QSA]

  RewriteCond %{REQUEST_URI} ^/api/client-logos/?$ [NC]
  RewriteCond %{DOCUMENT_ROOT}/api/client-logos.php -f
  RewriteRule ^api/client-logos/?$ /api/client-logos.php [L,QSA]

  RewriteCond %{REQUEST_URI} ^/api/sliders/?$ [NC]
  RewriteCond %{DOCUMENT_ROOT}/api/sliders.php -f
  RewriteRule ^api/sliders/?$ /api/sliders.php [L,QSA]

  # 7B-2. Explicit Static Bypass for Search Crawlers (Favicon, Manifest, OG Banner, Robots, Sitemap)
  RewriteRule ^(favicon\.ico|favicon-[0-9]+x[0-9]+\.png|favicon\.png|favicon\.svg|icon-[0-9]+\.png|apple-touch-icon\.png|og-image\.(jpg|jpeg|png)|site\.webmanifest|robots\.txt|sitemap\.xml)$ - [L]

  # 7C. If requested resource is a physical file or directory, serve it directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 7D. Check if a pre-rendered static route exists (e.g. /about -> /about/index.html)
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}/index.html -f
  RewriteRule ^(.*)$ /$1/index.html [L]

  # 7E. React Single Page App Fallback: send all other paths to root index.html
  RewriteRule ^ index.html [L]
</IfModule>

# 8. Security Hardening: Block sensitive files and folders
<IfModule mod_authz_core.c>
  <FilesMatch "(^#.*#|\.(bak|config|sql|fla|psd|ini|log|sh|inc|swp|dist|env|git|env\.example)|~)$">
    Require all denied
  </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
  <FilesMatch "(^#.*#|\.(bak|config|sql|fla|psd|ini|log|sh|inc|swp|dist|env|git|env\.example)|~)$">
    Order allow,deny
    Deny from all
  </FilesMatch>
</IfModule>
